<mvc:View controllerName="logaligroup.invoices.controller.MainView"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Page id="page" title="{i18n>title}">
        <content>
            <Panel id="selectionScreenPanel" headerText="{i18n>selectionScreen}">
                <Label id="labelShipName" labelFor="shipName" text="{i18n>shipName}" class="sapUiSmallMargin"></Label>
                <Input id="shipName" value="{selectionScreen>/ShipName}" width="200px" class="sapUiSmallMarginEnd"></Input>
                <Label id="labelCountry" text="{i18n>country}" class="sapUiSmallMargin"></Label>
                <Select id="slCountry" selectedKey="{selectionScreen>/CountryKey}" 
                                       forceSelection="false" 
                                       items="{selectionScreen>/Countries}">
                    <items>
                        <core:Item id="countryItem" key="{selectionScreen>key}" text="{selectionScreen>text}"></core:Item>
                    </items>
                </Select>
                <Button id="btnFilter"
                        text="{i18n>btnFilter}" 
                        icon="sap-icon://filter" 
                        press="onFilter" 
                        class="sapUiSmallMarginEnd">
                </Button>
                <Button id="btnClearFilter" 
                        text="{i18n>btnClearFilters}" 
                        icon="sap-icon://clear-filter" 
                        press="onClearFilter" 
                        class="sapUiSmallMarginEnd">
                </Button>
            </Panel>
        </content>
    </Page>
</mvc:View>